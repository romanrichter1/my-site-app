{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/nexivo_landing",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nexivo_login",
      "destination": "/klient",
      "permanent": true
    },
    {
      "source": "/nexivo_register",
      "destination": "/klient",
      "permanent": true
    },
    {
      "source": "/ai-pro-maklere",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "nexivoagency.eu"
        }
      ],
      "destination": "https://nexivoai.cz/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.nexivoai.cz"
        }
      ],
      "destination": "https://nexivoai.cz/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(business|maestro_barbershop|tictactoe|nexivo_coldemail|nexivo_email_mailchimp_penziony|og-gen|schuzka)(.html)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/vyzkouset",
      "destination": "https://nexivo-portal.vercel.app/portal/vyzkouset"
    },
    {
      "source": "/portal",
      "destination": "https://nexivo-portal.vercel.app/portal/"
    },
    {
      "source": "/portal/",
      "destination": "https://nexivo-portal.vercel.app/portal/"
    },
    {
      "source": "/portal/:path*",
      "destination": "https://nexivo-portal.vercel.app/portal/:path*"
    }
  ]
}
